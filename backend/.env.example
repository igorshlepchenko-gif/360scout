# Database — Railway provides this automatically when you add PostgreSQL plugin
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# APIs
API_FOOTBALL_KEY=your_key_here
OPENWEATHER_KEY=your_key_here
ODDS_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here

# App
APP_ENV=production
SECRET_KEY=generate_a_random_string_here
FRONTEND_URL=https://your-app.vercel.app

# Cache
API_FOOTBALL_CACHE_MINUTES=60

# Auth — seeds the one admin account on first startup (idempotent, never overwrites
# an existing user). Session idle-timeout below 2 minutes is unreliable for testing —
# see the throttled-touch note in app/api/deps.py.
SESSION_IDLE_MINUTES=20
SESSION_ABSOLUTE_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_first_run
